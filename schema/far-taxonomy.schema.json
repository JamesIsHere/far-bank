{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpa-learning.local/schema/far-taxonomy.schema.json",
  "title": "FAR Blueprint taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_id", "source_id", "source_manifest", "exam_section", "areas"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "taxonomy_id": {"type": "string", "pattern": "^far-[0-9]{4}-[0-9]{2}(?:-[a-z0-9-]+)?$"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_manifest": {"type": "string", "pattern": "^sources/aicpa/[0-9]{4}-[0-9]{2}/source-manifest\\.json$"},
    "exam_section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "official_title"],
      "properties": {
        "code": {"const": "FAR"},
        "official_title": {"const": "Financial Accounting and Reporting"}
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/area"}
    }
  },
  "$defs": {
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_page", "printed_page_label", "location_type", "anchor_text", "occurrence_on_page"],
      "properties": {
        "physical_page": {"type": "integer", "minimum": 1},
        "printed_page_label": {"type": "string", "pattern": "^FAR[1-9][0-9]*$"},
        "location_type": {"enum": ["section_heading", "table_heading", "table_row"]},
        "anchor_text": {"type": "string", "minLength": 1},
        "occurrence_on_page": {"type": "integer", "minimum": 1},
        "row_ordinal_on_page": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"location_type": {"const": "table_row"}}},
          "then": {"required": ["row_ordinal_on_page"]}
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal_within_parent", "official_text", "skill_level", "source_locator"],
      "properties": {
        "id": {"type": "string", "pattern": "^far\\.area\\.[1-9][0-9]*\\.group\\.[a-z]+(?:\\.topic\\.[1-9][0-9]*)?\\.task\\.[0-9]{3}$"},
        "ordinal_within_parent": {"type": "integer", "minimum": 1},
        "official_text": {"type": "string", "minLength": 1},
        "skill_level": {"enum": ["remembering_and_understanding", "application", "analysis"]},
        "source_locator": {"$ref": "#/$defs/sourceLocator"}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "official_title", "official_heading", "source_locator", "tasks"],
      "properties": {
        "id": {"type": "string", "pattern": "^far\\.area\\.[1-9][0-9]*\\.group\\.[a-z]+\\.topic\\.[1-9][0-9]*$"},
        "code": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "official_title": {"type": "string", "minLength": 1},
        "official_heading": {"type": "string", "minLength": 1},
        "source_locator": {"$ref": "#/$defs/sourceLocator"},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/task"}
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "official_title", "official_heading", "source_locator", "topics", "tasks"],
      "properties": {
        "id": {"type": "string", "pattern": "^far\\.area\\.[1-9][0-9]*\\.group\\.[a-z]+$"},
        "code": {"type": "string", "pattern": "^[A-Z]+$"},
        "official_title": {"type": "string", "minLength": 1},
        "official_heading": {"type": "string", "minLength": 1},
        "source_locator": {"$ref": "#/$defs/sourceLocator"},
        "topics": {"type": "array", "items": {"$ref": "#/$defs/topic"}},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
      },
      "anyOf": [
        {"properties": {"topics": {"minItems": 1}}},
        {"properties": {"tasks": {"minItems": 1}}}
      ]
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "official_title", "official_heading", "allocation_percent", "source_locator", "groups"],
      "properties": {
        "id": {"type": "string", "pattern": "^far\\.area\\.[1-9][0-9]*$"},
        "code": {"enum": ["I", "II", "III"]},
        "official_title": {"type": "string", "minLength": 1},
        "official_heading": {"type": "string", "minLength": 1},
        "allocation_percent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 0, "maximum": 100},
            "maximum": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        "source_locator": {"$ref": "#/$defs/sourceLocator"},
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/group"}
        }
      }
    }
  }
}
