{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpa-learning.local/schema/verification-event.schema.json",
  "title": "Append-only exact-version verification event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "recorded_at", "subject", "checker", "required_check_set_id", "input_evidence", "checks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^far-verification-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "subject": {"$ref": "#/$defs/exactVersion"},
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker_id", "checker_version"],
      "properties": {
        "checker_id": {"type": "string", "minLength": 1},
        "checker_version": {"type": "string", "minLength": 1}
      }
    },
    "required_check_set_id": {"type": "string", "minLength": 1},
    "input_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_or_id", "sha256"],
        "properties": {
          "path_or_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "category", "outcome", "detail", "calibration_fixture_ids"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "category": {"enum": ["SCHEMA", "RECOMPUTE", "RULE_TRACE", "DISTRACTORS", "LANGUAGE", "ORIGINALITY", "APPROVAL_INTEGRITY", "COVERAGE", "VARIETY", "REPRODUCIBILITY"]},
          "outcome": {"enum": ["pass", "fail", "flag"]},
          "detail": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "calibration_fixture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "exactVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "version_id", "content_sha256"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^far-q-[0-9]{6}$"},
        "version_id": {"type": "string", "pattern": "^far-q-[0-9]{6}\\.v[0-9]{3}$"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
