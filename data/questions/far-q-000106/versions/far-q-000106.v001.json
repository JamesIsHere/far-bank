                  "coefficient": -1
                }
              ],
              "constant": 0,
              "output_unit": "USD",
              "rounding": {
                "mode": "none",
                "decimal_places": 0
              }
            }
          }
        }
      },
      {
        "option_id": "D",
        "text": "$150,000",
        "structured_value": {
          "value_type": "number",
          "value": 150000,
          "unit": "USD"
        },
        "is_keyed": false,
        "error_model": {
          "error_model_id": "error-ignore-prior-accrual",
          "name": "Ignore prior lawsuit accrual",
          "misconception": "Adds the full settlement rather than only the increment over the existing accrual.",
          "derivation": "$90,000 + $60,000 = $150,000.",
          "reproduction": {
            "route_type": "linear_combination",
