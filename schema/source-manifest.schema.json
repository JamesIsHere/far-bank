{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpa-learning.local/schema/source-manifest.schema.json",
  "title": "Official CPA Blueprint source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "source_id",
    "authority",
    "publication",
    "retrieval",
    "far_scope",
    "verification",
    "recorded_anomalies"
  ],
  "properties": {
    "manifest_version": {"type": "string", "const": "1.0.0"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "publisher_abbreviation", "landing_page_url", "artifact_url"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "publisher_abbreviation": {"type": "string", "minLength": 1},
        "landing_page_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "artifact_url": {"type": "string", "format": "uri", "pattern": "^https://.*\\.pdf$"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover_title", "approved_by", "approval_date", "effective_period_label", "effective_from"],
      "properties": {
        "cover_title": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approval_date": {"type": "string", "format": "date"},
        "effective_period_label": {"type": "string", "minLength": 1},
        "effective_from": {"type": "string", "format": "date"}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieved_at", "local_file", "media_type", "size_bytes", "sha256", "pdf_version", "page_count", "encrypted"],
      "properties": {
        "retrieved_at": {"type": "string", "format": "date-time"},
        "local_file": {"type": "string", "pattern": "^[^/\\\\]+\\.pdf$"},
        "media_type": {"const": "application/pdf"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pdf_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "page_count": {"type": "integer", "minimum": 1},
        "encrypted": {"type": "boolean"}
      }
    },
    "far_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_code", "section_title", "physical_pdf_pages", "printed_page_labels"],
      "properties": {
        "section_code": {"const": "FAR"},
        "section_title": {"const": "Financial Accounting and Reporting"},
        "physical_pdf_pages": {"$ref": "#/$defs/pageRange"},
        "printed_page_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first", "last"],
          "properties": {
            "first": {"type": "string", "pattern": "^FAR[1-9][0-9]*$"},
            "last": {"type": "string", "pattern": "^FAR[1-9][0-9]*$"}
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf_header", "text_extraction", "visual_inspection"],
      "properties": {
        "pdf_header": {"type": "string", "pattern": "^%PDF-[0-9]+\\.[0-9]+$"},
        "text_extraction": {"$ref": "#/$defs/checkRecord"},
        "visual_inspection": {
          "allOf": [{"$ref": "#/$defs/checkRecord"}],
          "type": "object",
          "required": ["physical_pages_checked"],
          "properties": {
            "physical_pages_checked": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "resolution_dpi": {"type": "integer", "minimum": 72}
          }
        }
      }
    },
    "recorded_anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "field", "observed", "controlling_evidence", "disposition"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "field": {"type": "string", "minLength": 1},
          "observed": {"type": "string", "minLength": 1},
          "controlling_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "disposition": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "pageRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": {"type": "integer", "minimum": 1},
        "last": {"type": "integer", "minimum": 1}
      }
    },
    "checkRecord": {
      "type": "object",
      "required": ["tool", "result"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "pass_with_warnings", "fail"]},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
