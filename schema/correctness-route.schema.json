{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpa-learning.local/schema/correctness-route.schema.json",
  "title": "Independent FAR correctness-route evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "purpose", "contract_id", "route_id", "route_type", "producer_component_id", "verifier_component_id", "shared_deciding_function", "inputs", "specification", "expected_output", "independence_limit"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fixture_id": {"type": "string", "pattern": "^route-fixture-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "purpose": {"enum": ["calibration_fixture", "production_evidence"]},
    "contract_id": {"const": "far-g2-production-contract.v001"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "version_id", "content_sha256"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^far-q-[0-9]{6}$"},
        "version_id": {"type": "string", "pattern": "^far-q-[0-9]{6}\\.v[0-9]{3}$"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "route_id": {"type": "string", "pattern": "^route-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "route_type": {"enum": ["percentage", "ratio", "present_value", "effective_interest", "per_share", "date_period_schedule", "conditional_rule_table", "journal_entry", "linked_roll_forward", "independent_assertion_fixture"]},
    "producer_component_id": {"type": "string", "minLength": 1},
    "verifier_component_id": {"type": "string", "minLength": 1},
    "reference_fixture_component_id": {"type": "string", "minLength": 1},
    "shared_deciding_function": {"const": false},
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["input_id", "value_type", "value"],
        "properties": {
          "input_id": {"type": "string", "pattern": "^input-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "value_type": {"enum": ["number", "text", "date", "boolean"]},
          "value": {"type": ["number", "string", "boolean"]},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    },
    "specification": {"type": "object", "minProperties": 1},
    "expected_output": {
      "type": "object", "additionalProperties": false,
      "required": ["value_type", "value"],
      "properties": {
        "value_type": {"enum": ["number", "text", "boolean", "array", "object"]},
        "value": {"type": ["number", "string", "boolean", "array", "object"]},
        "unit": {"type": "string", "minLength": 1},
        "rounding": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "decimal_places"],
          "properties": {
            "mode": {"enum": ["half_even", "half_up", "truncate", "none"]},
            "decimal_places": {"type": "integer", "minimum": 0, "maximum": 9}
          }
        }
      }
    },
    "independence_limit": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"purpose": {"const": "production_evidence"}}, "required": ["purpose"]},
      "then": {"required": ["subject"]},
      "else": {"not": {"required": ["subject"]}}
    },
    {
      "if": {"properties": {"route_type": {"const": "independent_assertion_fixture"}}, "required": ["route_type"]},
      "then": {"required": ["reference_fixture_component_id"]}
    }
  ]
}
