{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpa-learning.local/schema/taxonomy-supplement.schema.json",
  "title": "Project-authored annotations kept separate from official FAR taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_id", "annotations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "taxonomy_id": {"type": "string", "pattern": "^far-[0-9]{4}-[0-9]{2}(?:-[a-z0-9-]+)?$"},
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "concept_tags", "teaching_labels", "notes"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^far\\."},
          "concept_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "teaching_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
