{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpa-learning.local/schema/question-identity.schema.json",
  "title": "Stable FAR question identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "created_at", "creation_provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "question_id": {"type": "string", "pattern": "^far-q-[0-9]{6}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "creation_provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "materialInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "input_kind", "version_or_date", "use"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "input_kind": {"enum": ["taxonomy", "rule", "source", "rubric", "generator", "human_brief", "fixture"]},
        "version_or_date": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "use": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "mechanism", "created_by", "material_inputs"],
      "properties": {
        "purpose": {"enum": ["schema_fixture", "sample_candidate"]},
        "mechanism": {"enum": ["human", "ai_assisted", "deterministic_generator"]},
        "created_by": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "generation_run_id": {"type": "string", "minLength": 1},
        "material_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/materialInput"}}
      },
      "allOf": [
        {
          "if": {"properties": {"mechanism": {"const": "ai_assisted"}}, "required": ["mechanism"]},
          "then": {"required": ["model_id"]}
        },
        {
          "if": {"properties": {"mechanism": {"const": "deterministic_generator"}}, "required": ["mechanism"]},
          "then": {"required": ["generator_version", "generation_run_id"]}
        }
      ]
    }
  }
}
