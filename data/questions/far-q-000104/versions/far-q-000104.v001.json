    "stem": "An inventory analyst is reconciling records that show beginning inventory of $180,000, purchases received of $520,000, cost of goods sold of $470,000, returns to suppliers of $20,000, and a supported physical count of $205,000. Sales revenue was $700,000. All inventory amounts are at cost, no write-down is indicated, and the source records are complete. What adjustment should be made to the inventory general ledger?",
    "options": [
      {
        "option_id": "A",
        "text": "$5,000 decrease",
        "structured_value": {
          "value_type": "number",
          "value": -5000,
          "unit": "USD"
        },
        "is_keyed": true
      },
      {
        "option_id": "B",
        "text": "$5,000 increase",
        "structured_value": {
          "value_type": "number",
          "value": 5000,
          "unit": "USD"
        },
        "is_keyed": false,
        "error_model": {
          "error_model_id": "error-reverse-adjustment",
          "name": "Reverse adjustment direction",
          "misconception": "Computes book minus physical instead of the adjustment needed to move book to physical.",
          "derivation": "$210,000 book - $205,000 physical = a mistaken $5,000 increase.",
          "reproduction": {
            "route_type": "linear_combination",
            "linear_combination": {
              "terms": [
                {
                  "fact_id": "fact-beginning-inventory",
                  "coefficient": 1
                },
                {
                  "fact_id": "fact-purchases",
                  "coefficient": 1
                },
                {
                  "fact_id": "fact-cogs",
                  "coefficient": -1
                },
                {
                  "fact_id": "fact-supplier-returns",
                  "coefficient": -1
                },
                {
                  "fact_id": "fact-physical-inventory",
                  "coefficient": -1
                }
              ],
              "constant": 0,
              "output_unit": "USD",
              "rounding": {
                "mode": "none",
                "decimal_places": 0
              }
            }
          }
        }
      },
      {
        "option_id": "C",
        "text": "No adjustment",
        "structured_value": {
          "value_type": "number",
          "value": 0,
          "unit": "USD"
        },
        "is_keyed": false,
        "error_model": {
          "error_model_id": "error-assume-agreement",
          "name": "Assume records agree",
          "misconception": "Stops after accepting the physical count without comparing it to the rollforward.",
          "derivation": "Records a zero adjustment.",
          "reproduction": {
            "route_type": "linear_combination",
            "linear_combination": {
              "terms": [
                {
                  "fact_id": "fact-beginning-inventory",
                  "coefficient": 0
                }
              ],
              "constant": 0,
              "output_unit": "USD",
              "rounding": {
                "mode": "none",
                "decimal_places": 0
              }
            }
          }
        }
      },
      {
        "option_id": "D",
        "text": "$25,000 decrease",
        "structured_value": {
          "value_type": "number",
          "value": -25000,
          "unit": "USD"
        },
        "is_keyed": false,
        "error_model": {
          "error_model_id": "error-omit-supplier-returns",
          "name": "Omit supplier returns",
          "misconception": "Leaves returned goods in the book rollforward.",
          "derivation": "$205,000 - ($180,000 + $520,000 - $470,000) = a $25,000 decrease.",
          "reproduction": {
            "route_type": "linear_combination",
            "linear_combination": {
              "terms": [
                {
                  "fact_id": "fact-physical-inventory",
                  "coefficient": 1
                },
                {
