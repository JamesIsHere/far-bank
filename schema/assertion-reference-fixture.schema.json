{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpa-learning.local/schema/assertion-reference-fixture.schema.json",
  "title": "Independently authored nonnumeric assertion cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "authorship", "cases", "claim_limit"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fixture_id": {"type": "string", "pattern": "^assertion-reference-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "authorship": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "mechanism", "created_by", "created_at"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "mechanism": {"const": "independent_fixture_pass"},
        "created_by": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "expected_assertion_ids", "provenance"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "expected_assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "provenance": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim_limit": {"type": "string", "minLength": 1}
  }
}
