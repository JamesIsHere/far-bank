    "solution": {
      "end_ask": "Determine the signed adjustment that moves book inventory to the supported physical amount.",
      "representation": {
        "kind": "roll_forward",
        "setup": "Book ending inventory = beginning + purchases - COGS - supplier returns; adjustment = physical - book."
      },
      "steps": [
        {
          "step_number": 1,
          "instruction": "Build the book inventory rollforward.",
          "fact_ids_used": [
            "fact-beginning-inventory",
            "fact-purchases",
            "fact-cogs",
            "fact-supplier-returns"
          ],
          "assertion_ids_used": [
            "assertion-inventory-cost-balance"
          ],
          "result": "$180,000 + $520,000 - $470,000 - $20,000 = $210,000."
        },
        {
          "step_number": 2,
          "instruction": "Compare supported physical inventory with the book balance.",
          "fact_ids_used": [
            "fact-physical-inventory"
          ],
          "assertion_ids_used": [
            "assertion-reconcile-physical"
          ],
          "result": "$205,000 - $210,000 = $(5,000)."
        },
        {
          "step_number": 3,
          "instruction": "Translate the signed difference into the ledger action.",
          "fact_ids_used": [
            "fact-physical-inventory"
          ],
          "assertion_ids_used": [
            "assertion-reconcile-physical"
          ],
          "result": "Decrease inventory by $5,000."
        }
      ],
      "keyed_answer_option_id": "A",
      "keyed_answer_rationale": "Book inventory is $210,000 and supported physical inventory is $205,000, so the ledger must decrease $5,000.",
      "faster_or_safer_route": "Write the rollforward signs before calculating, then use target minus book to preserve adjustment direction."
